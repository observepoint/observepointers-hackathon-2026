{
  "recipeId": "create_first_alert",
  "goal": "create an alert",
  "summary": "An alert is a threshold on a number in an audit report. The metric lives four levels down a nested menu, so we'll point at each one: Audits → Tag & Variable Rules → Rule Failures, greater than 0. You confirm the email.",
  "executionMode": "templated",
  "parameters": {
    "notifyEmail": "jun@observepoint.com",
    "siteUrl": "",
    "threshold": "0",
    "alertName": "Rule failures"
  },
  "steps": [
    {
      "actor": "user",
      "targetSelector": "[op-selector=\"sidebar-alerts\"]",
      "say": "Open Alerts under Standards in the sidebar.",
      "targetFallback": {
        "description": "the \"Alerts\" link under Standards in the left sidebar"
      },
      "completion": {
        "type": "url_change",
        "value": "/alerts"
      },
      "id": "s1",
      "unverified": true
    },
    {
      "actor": "user",
      "targetSelector": "button[aria-label=\"Create Alert\"]",
      "say": "Start a new alert.",
      "targetFallback": {
        "description": "the \"Create Alert\" button"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": "alert-name-control input"
      },
      "id": "s2",
      "unverified": true
    },
    {
      "actor": "ai",
      "targetSelector": "alert-name-control input",
      "say": "Naming it \"Rule failures\".",
      "targetFallback": {
        "description": "the alert name field at the top of the designer"
      },
      "action": {
        "type": "fill_text",
        "value": "Rule failures"
      },
      "completion": {
        "type": "dom_event",
        "value": "change"
      },
      "id": "s3",
      "unverified": true
    },
    {
      "actor": "user",
      "targetSelector": "input[aria-label=\"Select report metric\"]",
      "say": "Open Report Metric.",
      "targetFallback": {
        "description": "the \"Report Metric\" field"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": "button[mat-menu-item]"
      },
      "id": "s4",
      "unverified": true
    },
    {
      "actor": "user",
      "targetSelector": "button[mat-menu-item] >> text=Audits",
      "say": "Open \"Audits\".",
      "targetFallback": {
        "description": "\"Audits\" in the report metric menu"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      },
      "id": "s5",
      "unverified": true
    },
    {
      "actor": "user",
      "targetSelector": "button[mat-menu-item] >> text=Tag & Variable Rules",
      "say": "Open \"Tag & Variable Rules\".",
      "targetFallback": {
        "description": "\"Tag & Variable Rules\" in the report metric menu"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      },
      "id": "s6",
      "unverified": true
    },
    {
      "actor": "user",
      "targetSelector": "button[mat-menu-item] >> text=Rule Failures",
      "say": "Choose \"Rule Failures\" — that's the metric.",
      "targetFallback": {
        "description": "\"Rule Failures\" in the report metric menu"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": "alert-trigger mat-select[formControlName=\"operator\"]"
      },
      "id": "s7",
      "unverified": true
    },
    {
      "actor": "user",
      "targetSelector": "alert-trigger mat-select[formControlName=\"operator\"]",
      "say": "Open Operator.",
      "targetFallback": {
        "description": "the Operator dropdown"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".alert-operator-selector mat-option"
      },
      "id": "s8",
      "unverified": true
    },
    {
      "actor": "user",
      "targetSelector": ".alert-operator-selector mat-option >> text=Greater than (>)",
      "say": "Choose \"Greater than (>)\".",
      "targetFallback": {
        "description": "the \"Greater than (>)\" option"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      },
      "id": "s9",
      "unverified": true
    },
    {
      "actor": "ai",
      "targetSelector": "alert-trigger input[formControlName=\"targetValue\"]",
      "say": "Setting the threshold to 0 — one failure is a failure.",
      "targetFallback": {
        "description": "the threshold value field"
      },
      "action": {
        "type": "fill_text",
        "value": "0"
      },
      "completion": {
        "type": "dom_event",
        "value": "change"
      },
      "id": "s10",
      "unverified": true
    },
    {
      "actor": "user",
      "targetSelector": "[op-selector=\"alert-designer-continue-btn\"]",
      "say": "Next — on to who gets notified.",
      "targetFallback": {
        "description": "the Next button in the alert designer"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": "mat-chip-grid#email-chip-grid input"
      },
      "id": "s11",
      "unverified": true
    },
    {
      "actor": "ai",
      "targetSelector": "mat-chip-grid#email-chip-grid input",
      "say": "Typed jun@observepoint.com — press Enter to add it, then Continue.",
      "targetFallback": {
        "description": "the subscribers field"
      },
      "action": {
        "type": "fill_text",
        "value": "jun@observepoint.com"
      },
      "completion": {
        "type": "dom_event",
        "value": "change"
      },
      "id": "s12",
      "unverified": true
    },
    {
      "actor": "user",
      "targetSelector": "[op-selector=\"alert-designer-continue-btn\"]",
      "say": "Next — on to which audits it applies to.",
      "targetFallback": {
        "description": "the Next button in the alert designer"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      },
      "id": "s13",
      "unverified": true
    },
    {
      "actor": "user",
      "targetSelector": "[op-selector=\"alert-designer-continue-btn\"]",
      "say": "Next — the preview shows what would have triggered.",
      "targetFallback": {
        "description": "the Next button in the alert designer"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      },
      "id": "s14",
      "unverified": true
    },
    {
      "actor": "user",
      "targetSelector": "[op-selector=\"alert-designer-save-btn\"]",
      "say": "Save it. It's now attachable to any audit under Standards.",
      "targetFallback": {
        "description": "the Save button in the alert designer"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      },
      "id": "s15",
      "unverified": true
    }
  ]
}
