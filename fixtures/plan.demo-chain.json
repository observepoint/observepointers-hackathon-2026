        "id": "s19"
      },
      {
        "actor": "user",
        "targetSelector": "then-condition rule-tag-variable-filter mat-select[formControlName=\"matchType\"] >> last",
        "say": "Set OPERATOR to \"is set\".",
        "targetFallback": {
          "description": "the OPERATOR cell in this row"
