  {
    "recipeId": "create_first_alert",
    "goal": "observepoint.com uses OneTrust — import our consent categories for Utah, then edit My First Audit to check the site against them with tag rules, follow the Timing Value best practice on Google Universal Analytics, and alert me if anything breaks",
    "summary": "An alert is a threshold on a number in an audit report. The metric lives four levels down a nested menu, so we'll point at each one: Audits → Tag & Variable Rules → Rule Failures, greater than 0 on observepoint.com. You confirm the email.",
    "executionMode": "templated",
    "parameters": {
      "siteUrl": "https://observepoint.com",
      "location": "Utah",
      "auditName": "My First Audit",
      "tagName": "Google Universal Analytics",
      "expectVariables": "utt, utc, utv",
      "whenVariable": "t",
      "whenValue": "timing",
      "notifyEmail": "jun@observepoint.com",
      "ruleName": "Google Universal Analytics sets utt, utc, utv",
      "threshold": "0",
      "alertName": "observepoint.com — Rule failures"
    },
    "steps": [
      {
        "actor": "user",
        "targetSelector": "[op-selector=\"sidebar-alerts\"]",
        "say": "Open Alerts under Standards in the sidebar.",
        "targetFallback": {
          "description": "the \"Alerts\" link under Standards in the left sidebar"
        },
        "completion": {
          "type": "url_change",
          "value": "/alerts-library"
        },
        "id": "s1"
      },
      {
        "actor": "user",
        "targetSelector": "button[aria-label=\"Create Alert\"]",
        "say": "Start a new alert.",
        "targetFallback": {
          "description": "the \"Create Alert\" button"
        },
        "completion": {
          "type": "dom_mutation",
          "condition": "visible",
          "targetSelector": "alert-name-control input"
        },
        "id": "s2"
      },
      {
        "actor": "ai",
        "targetSelector": "alert-name-control input",
        "say": "Naming it \"observepoint.com — Rule failures\".",
        "targetFallback": {
          "description": "the alert name field at the top of the designer"
        },
        "action": {
          "type": "fill_text",
          "value": "observepoint.com — Rule failures"
        },
        "completion": {
          "type": "dom_event",
          "value": "change"
        },
        "id": "s3"
      },
      {
        "actor": "user",
        "targetSelector": "input[aria-label=\"Select report metric\"]",
        "say": "Open Report Metric.",
        "targetFallback": {
          "description": "the \"Report Metric\" field"
        },
        "completion": {
          "type": "dom_mutation",
          "condition": "visible",
          "targetSelector": "button[mat-menu-item]"
        },
        "id": "s4"
      },
      {
        "actor": "user",
        "targetSelector": "button[mat-menu-item] >> text=Audits",
        "say": "Open \"Audits\".",
        "targetFallback": {
          "description": "\"Audits\" in the report metric menu"
        },
        "completion": {
          "type": "dom_event",
          "value": "click"
        },
        "id": "s5"
      },
      {
        "actor": "user",
        "targetSelector": "button[mat-menu-item] >> text=Tag & Variable Rules",
        "say": "Open \"Tag & Variable Rules\".",
        "targetFallback": {
          "description": "\"Tag & Variable Rules\" in the report metric menu"
        },
        "completion": {
          "type": "dom_event",
          "value": "click"
        },
        "id": "s6"
      },
      {
        "actor": "user",
        "targetSelector": "button[mat-menu-item] >> text=Rule Failures",
        "say": "Choose \"Rule Failures\" — that's the metric.",
        "targetFallback": {
          "description": "\"Rule Failures\" in the report metric menu"
        },
        "completion": {
          "type": "dom_event",
          "value": "click"
        },
        "id": "s7"
      },
      {
        "actor": "user",
        "targetSelector": "alert-trigger mat-select[formControlName=\"operator\"]",
        "say": "Open Operator.",
        "targetFallback": {
          "description": "the Operator dropdown"
        },
        "completion": {
          "type": "dom_mutation",
          "condition": "visible",
          "targetSelector": ".alert-operator-selector mat-option"
        },
        "id": "s8"
      },
      {
        "actor": "user",
        "targetSelector": ".alert-operator-selector mat-option >> text=Greater than (>)",
