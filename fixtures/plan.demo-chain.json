[
  {
    "recipeId": "import_consent_from_onetrust",
    "goal": "observepoint.com uses OneTrust — import our consent categories for Utah, then edit My First Audit to check the site against them with tag rules, follow the Timing Value best practice on Google Universal Analytics, and alert me if anything breaks",
    "summary": "OneTrust already has your approved tags and cookies, one set per domain and location, so this imports rather than rebuilds. We'll pull https://observepoint.com for Utah — rerun it per location if you need more than one.",
    "executionMode": "templated",
    "parameters": {
      "siteUrl": "https://observepoint.com",
      "location": "Utah",
      "auditName": "My First Audit",
      "tagName": "Google Universal Analytics",
      "expectVariables": "utt, utc, utv",
      "whenVariable": "t",
      "whenValue": "timing",
      "notifyEmail": "jun@observepoint.com"
    },
    "steps": [
      {
        "actor": "user",
        "targetSelector": "[op-selector=\"sidebar-standards-consent-categories\"]",
        "say": "Open Consent Categories under Standards in the sidebar.",
        "targetFallback": {
          "description": "the \"Consent Categories\" link under Standards in the left sidebar"
        },
        "completion": {
          "type": "url_change",
          "value": "/consent-categories"
        },
        "id": "s1"
      },
      {
        "actor": "user",
        "targetSelector": "button[aria-label=\"Create a consent category\"], button[aria-label=\"CREATE\"]",
        "say": "Open the create menu.",
        "targetFallback": {
          "description": "the create button on the Consent Categories page"
        },
        "completion": {
          "type": "dom_mutation",
          "condition": "visible",
          "targetSelector": "[op-selector=\"cc-import-onetrust\"]"
        },
        "id": "s2"
      },
      {
        "actor": "user",
        "targetSelector": "[op-selector=\"cc-import-onetrust\"]",
        "say": "Choose the OneTrust import.",
        "targetFallback": {
          "description": "\"Import Consent Categories\" with the OneTrust logo"
        },
        "completion": {
          "type": "dom_mutation",
          "condition": "visible",
          "targetSelector": "[op-selector=\"cc-onetrust-url\"]"
        },
        "id": "s3"
      },
      {
        "actor": "ai",
        "targetSelector": "[op-selector=\"cc-onetrust-url\"]",
        "say": "Setting the site to read the banner from.",
        "targetFallback": {
          "description": "the \"Where can the consent banner be found?\" field"
        },
        "action": {
          "type": "fill_text",
          "value": "https://observepoint.com"
        },
        "completion": {
          "type": "dom_event",
          "value": "change"
        },
        "id": "s4"
      },
      {
        "actor": "user",
        "targetSelector": "[op-selector=\"cc-onetrust-location\"]",
        "say": "Open the location list.",
        "targetFallback": {
          "description": "the \"From Which Location?\" dropdown"
        },
        "completion": {
          "type": "dom_mutation",
          "condition": "visible",
          "targetSelector": "input.mat-select-search-input:not(.mat-select-search-hidden)"
        },
        "id": "s5"
      },
      {
        "actor": "ai",
        "targetSelector": "input.mat-select-search-input:not(.mat-select-search-hidden)",
        "say": "Filtering the list to \"Utah\".",
        "targetFallback": {
          "description": "the search box at the top of the location list"
        },
        "action": {
          "type": "fill_text",
          "value": "Utah"
        },
        "completion": {
          "type": "dom_event",
          "value": "input"
        },
        "id": "s6"
      },
      {
        "actor": "user",
        "targetSelector": "mat-option.loc-autocomplete >> text=Utah",
        "say": "Choose the Utah row.",
        "targetFallback": {
          "description": "the Utah option in the location list"
        },
        "completion": {
          "type": "dom_event",
          "value": "click"
        },
        "id": "s7"
      },
      {
        "actor": "user",
        "targetSelector": "[op-selector=\"cc-onetrust-detect\"]",
        "say": "Detect the categories. It takes 10–30 seconds.",
        "targetFallback": {
          "description": "the \"Detect Your Consent Categories\" button"
        },
        "completion": {
          "type": "dom_mutation",
          "condition": "visible",
          "targetSelector": ".options-selected-container"
        },
        "id": "s8"
      },
      {
        "actor": "user",
        "targetSelector": "[op-selector=\"cc-onetrust-sync\"]",
        "say": "Import them. This takes a moment — the banner says when it is done.",
        "targetFallback": {
          "description": "the \"Sync Categorized Cookies\" button"
        },
        "completion": {
          "type": "dom_mutation",
          "condition": "visible",
          "targetSelector": ".bulk-first-message >> text=Cookies are now synchronized"
        },
        "id": "s9"
      },
      {
        "actor": "user",
        "targetSelector": ".bulk-action-progress button >> text=Close",
        "say": "Done — close the banner. Rerun this per location if you need more.",
        "targetFallback": {
          "description": "the Close button on the sync banner"
        },
        "completion": {
          "type": "dom_mutation",
          "condition": "hidden",
          "targetSelector": ".bulk-action-progress"
        },
        "optional": true,
        "id": "s10"
      },
      {
        "actor": "user",
        "targetSelector": ".cc-import-modal-wrapper [op-selector=\"close-btn\"]",
        "say": "Close the importer too — the next part needs the sidebar.",
        "targetFallback": {
          "description": "the X at the top of the OneTrust import modal"
        },
        "completion": {
          "type": "dom_mutation",
          "condition": "hidden",
          "targetSelector": "[op-selector=\"cc-onetrust-url\"]"
        },
        "optional": true,
        "id": "s11"
      }
    ],
    "chain": ["create_tag_variable_rule", "create_first_alert", "edit_audit_add_standards"],
    "guards": ["nav-available"]
  },
  {
    "recipeId": "create_tag_variable_rule",
    "goal": "observepoint.com uses OneTrust — import our consent categories for Utah, then edit My First Audit to check the site against them with tag rules, follow the Timing Value best practice on Google Universal Analytics, and alert me if anything breaks",
    "summary": "A rule says what \"correct\" means; the audit is what checks it. This one asks Google Universal Analytics to set utt, utc, utv. Only on requests where t=timing, so it doesn't fail on every other hit. The grid has six columns and three of them are already right — we'll say which as we go.",
    "executionMode": "templated",
    "parameters": {
      "siteUrl": "https://observepoint.com",
      "location": "Utah",
      "auditName": "My First Audit",
      "tagName": "Google Universal Analytics",
      "expectVariables": "utt, utc, utv",
      "whenVariable": "t",
      "whenValue": "timing",
      "notifyEmail": "jun@observepoint.com",
      "ruleName": "Google Universal Analytics sets utt, utc, utv"
    },
    "steps": [
      {
        "actor": "user",
        "targetSelector": "[op-selector=\"sidebar-standards-rules\"]",
        "say": "Open Tag & Variable Rules under Standards in the sidebar.",
        "targetFallback": {
          "description": "the \"Tag & Variable Rules\" link under Standards in the left sidebar"
        },
        "completion": {
          "type": "url_change",
          "value": "/rules/library"
        },
        "id": "s1"
      },
      {
        "actor": "user",
        "targetSelector": "button[aria-label=\"Create Rule\"]",
        "say": "Start a new rule.",
        "targetFallback": {
          "description": "the \"Create Rule\" button"
        },
        "completion": {
          "type": "dom_mutation",
          "condition": "visible",
          "targetSelector": "rule-name-control input"
        },
        "id": "s2"
      },
      {
        "actor": "ai",
        "targetSelector": "rule-name-control input",
        "say": "Naming it \"Google Universal Analytics sets utt, utc, utv\".",
        "targetFallback": {
          "description": "the rule name field at the top of the builder"
        },
        "action": {
          "type": "fill_text",
          "value": "Google Universal Analytics sets utt, utc, utv"
        },
        "completion": {
          "type": "dom_event",
          "value": "change"
        },
        "id": "s3"
      },
      {
        "actor": "user",
        "targetSelector": "button[aria-label=\"Add condition\"]",
        "say": "Add a WHEN condition — it decides where this rule applies.",
        "targetFallback": {
          "description": "the \"Add condition\" button under WHEN"
        },
        "completion": {
          "type": "dom_mutation",
          "condition": "visible",
          "targetSelector": "if-condition mat-select[formControlName=\"type\"]"
        },
        "id": "s4"
      },
      {
        "actor": "user",
        "targetSelector": "if-condition mat-select[formControlName=\"type\"]",
        "say": "Open Filter By.",
        "targetFallback": {
          "description": "the \"Filter By\" dropdown"
        },
        "completion": {
          "type": "dom_mutation",
          "condition": "visible",
          "targetSelector": ".mat-mdc-select-panel mat-option"
        },
        "id": "s5"
      },
      {
        "actor": "user",
        "targetSelector": ".mat-mdc-select-panel mat-option >> text=Tag",
        "say": "Choose \"Tag\".",
        "targetFallback": {
          "description": "the \"Tag\" option"
        },
        "completion": {
          "type": "dom_event",
          "value": "click"
        },
        "id": "s6"
      },
      {
        "actor": "user",
        "targetSelector": "if-condition .main-filter mat-select[formControlName=\"matchType\"]",
        "say": "Operator is already \"equals\" — the only one Tag offers.",
        "targetFallback": {
          "description": "the Operator dropdown next to Filter By"
        },
        "advance": "continue",
        "completion": {
          "type": "dom_mutation",
          "targetSelector": "if-condition .main-filter mat-select[formControlName=\"matchType\"]"
        },
        "id": "s7"
      },
      {
        "actor": "ai",
        "targetSelector": "if-condition input[formControlName=\"tagId\"]",
        "say": "Searching tags for \"Google Universal Analytics\".",
        "targetFallback": {
          "description": "the Value field"
        },
        "action": {
          "type": "fill_text",
          "value": "Google Universal Analytics"
        },
        "completion": {
          "type": "dom_event",
          "value": "input"
        },
        "id": "s8"
      },
      {
        "actor": "user",
        "targetSelector": "mat-option.tag-id-option >> text=Google Universal Analytics",
        "say": "Pick Google Universal Analytics from the list.",
        "targetFallback": {
          "description": "Google Universal Analytics in the tag list"
        },
        "completion": {
          "type": "dom_event",
          "value": "click"
        },
        "id": "s9"
      },
      {
        "actor": "user",
        "targetSelector": "[op-selector=\"rule-when-add-variable\"]",
        "say": "Add a variable row.",
        "targetFallback": {
          "description": "the \"Add Variable\" link under the tag"
        },
        "completion": {
          "type": "dom_event",
          "value": "click"
        },
        "id": "s10"
      },
      {
        "actor": "ai",
        "targetSelector": "if-condition rule-tag-variable-filter input[formControlName=\"variable\"] >> last",
        "say": "Setting the variable to \"t\".",
        "targetFallback": {
          "description": "the VARIABLE cell in the new row"
        },
        "action": {
          "type": "fill_text",
          "value": "t"
        },
        "completion": {
          "type": "dom_event",
          "value": "input"
        },
        "id": "s11"
      },
      {
        "actor": "user",
        "targetSelector": "if-condition rule-tag-variable-filter mat-checkbox[formControlName=\"variableMatchAsRegex\"] >> last",
        "say": "REGEX left off — the name is exact, not a pattern.",
        "targetFallback": {
          "description": "the REGEX checkbox in this row"
        },
        "advance": "continue",
        "completion": {
          "type": "dom_mutation",
          "targetSelector": "if-condition rule-tag-variable-filter mat-checkbox[formControlName=\"variableMatchAsRegex\"]"
        },
        "id": "s12"
      },
      {
        "actor": "user",
        "targetSelector": "if-condition rule-tag-variable-filter mat-select[formControlName=\"matchType\"] >> last",
        "say": "OPERATOR is already \"equals\", which is what we want.",
        "targetFallback": {
          "description": "the OPERATOR cell in this row"
        },
        "advance": "continue",
        "completion": {
          "type": "dom_mutation",
          "targetSelector": "if-condition rule-tag-variable-filter mat-select[formControlName=\"matchType\"]"
        },
        "id": "s13"
      },
      {
        "actor": "user",
        "targetSelector": "if-condition rule-tag-variable-filter input[formControlName=\"selectorType\"] >> last",
        "say": "SELECTOR is already \"String\" — we are matching the value itself.",
        "targetFallback": {
          "description": "the SELECTOR cell in this row"
        },
        "advance": "continue",
        "completion": {
          "type": "dom_mutation",
          "targetSelector": "if-condition rule-tag-variable-filter input[formControlName=\"selectorType\"]"
        },
        "id": "s14"
      },
      {
        "actor": "ai",
        "targetSelector": "if-condition rule-tag-variable-filter input[formControlName=\"value\"] >> last",
        "say": "Setting VALUE to \"timing\".",
        "targetFallback": {
          "description": "the VALUE/VARIABLE cell in this row"
        },
        "action": {
          "type": "fill_text",
          "value": "timing"
        },
        "completion": {
          "type": "dom_event",
          "value": "input"
        },
        "id": "s15"
      },
      {
        "actor": "ai",
        "targetSelector": "then-condition input[formControlName=\"tagId\"]",
        "say": "Now EXPECT: the same tag again, this time as the subject.",
        "targetFallback": {
          "description": "the Select Tag under EXPECT field"
        },
        "action": {
          "type": "fill_text",
          "value": "Google Universal Analytics"
        },
        "completion": {
          "type": "dom_event",
          "value": "input"
        },
        "id": "s16"
      },
      {
        "actor": "user",
        "targetSelector": "mat-option.tag-id-option >> text=Google Universal Analytics",
        "say": "Pick Google Universal Analytics from the list.",
        "targetFallback": {
          "description": "Google Universal Analytics in the tag list"
        },
        "completion": {
          "type": "dom_event",
          "value": "click"
        },
        "id": "s17"
      },
      {
        "actor": "user",
        "targetSelector": "[op-selector=\"rule-expect-add-variable\"]",
        "say": "Add a variable row.",
        "targetFallback": {
          "description": "the \"Add Variable\" link under the tag"
        },
        "completion": {
          "type": "dom_event",
          "value": "click"
        },
        "id": "s18"
      },
      {
        "actor": "ai",
        "targetSelector": "then-condition rule-tag-variable-filter input[formControlName=\"variable\"] >> last",
        "say": "Setting the variable to \"utt\".",
        "targetFallback": {
          "description": "the VARIABLE cell in the new row"
        },
        "action": {
          "type": "fill_text",
          "value": "utt"
        },
        "completion": {
          "type": "dom_event",
