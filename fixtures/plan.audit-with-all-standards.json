{
  "recipeId": "audit_with_all_standards",
  "goal": "set up an audit for https://www.example.com with rules, consent categories and alerts",
  "summary": "Rules, Consent Categories and Alerts are three sub-tabs of one Standards screen, so this is a single audit rather than three. We'll create \"example.com — All standards\" against https://www.example.com and attach all three.",
  "executionMode": "templated",
  "parameters": {
    "siteUrl": "https://www.example.com",
    "auditName": "example.com — All standards"
  },
  "steps": [
    {
      "actor": "user",
      "navContext": "*",
      "targetSelector": "[op-selector=\"sidebar-create-new\"]",
      "say": "Click Create New in the left sidebar.",
      "targetFallback": {
        "description": "the \"Create New\" button in the left sidebar"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": "[op-selector=\"new-data-option-audit\"]"
      },
      "id": "s1"
    },
    {
      "actor": "user",
      "targetSelector": "[op-selector=\"new-data-option-audit\"]",
      "say": "Choose Audit.",
      "targetFallback": {
        "description": "the \"Audit\" option in the Create New dialog"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-audit-editor, .audit-setup-modal"
      },
      "id": "s2"
    },
    {
      "actor": "user",
      "optional": true,
      "targetSelector": "[op-selector=\"web-audit-switch-to-advanced-setup\"]",
      "say": "If you landed on the quick setup, switch to Advanced Setup — Standards lives there.",
      "targetFallback": {
        "description": "the \"Switch to Advanced Setup\" button"
      },
      "unverified": true,
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-audit-editor"
      },
      "id": "s3"
    },
    {
      "actor": "ai",
      "targetSelector": "audit-editor-header-name-control input",
      "say": "Naming it \"example.com — All standards\".",
      "targetFallback": {
        "description": "the audit name field in the editor header"
      },
      "action": {
        "type": "fill_text",
        "value": "example.com — All standards"
      },
      "completion": {
        "type": "dom_event",
        "value": "change"
      },
      "id": "s4"
    },
    {
      "actor": "user",
      "targetSelector": "[op-selector=\"audit-tab-url-sources\"], .op-audit-editor .op-tabs:not(.sub-menu) .op-tab:nth-child(2)",
      "say": "Open URL Sources.",
      "targetFallback": {
        "description": "the URL Sources tab in the audit editor"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      },
      "id": "s5"
    },
    {
      "actor": "ai",
      "targetSelector": "[op-selector=\"audit-setup-starting-urls-textarea\"] textarea",
      "say": "Setting the starting URL.",
      "targetFallback": {
        "description": "the \"URLs to Scan\" box on the URL Sources tab"
      },
      "action": {
        "type": "fill_text",
        "value": "https://www.example.com"
      },
      "completion": {
        "type": "dom_event",
        "value": "change"
      },
      "id": "s6"
    },
    {
      "actor": "user",
      "targetSelector": "[op-selector=\"audit-tab-standards\"], .op-audit-editor .op-tabs:not(.sub-menu) .op-tab:nth-child(4)",
      "say": "Open the Standards tab.",
      "targetFallback": {
        "description": "the Standards tab in the audit editor"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-tabs.sub-menu"
      },
      "id": "s7"
    },
    {
      "actor": "user",
      "targetSelector": "[op-selector=\"standards-tab-rules\"]",
      "say": "Open Tag & Variable Rules.",
      "targetFallback": {
        "description": "the \"Tag & Variable Rules\" sub-tab under Standards"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      },
      "id": "s8"
    },
    {
      "actor": "user",
      "targetSelector": ".op-standards-selector .add-all-standards-btn",
      "say": "Add the rules this audit should check.",
      "targetFallback": {
        "description": "the \"add all\" button in the picker"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      },
      "id": "s9"
    },
    {
      "actor": "user",
      "targetSelector": "[op-selector=\"standards-tab-consent-categories\"]",
      "say": "Open Consent Categories.",
      "targetFallback": {
        "description": "the \"Consent Categories\" sub-tab under Standards"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      },
      "id": "s10"
    },
    {
      "actor": "ai",
      "targetSelector": ".op-standards-selector .search-input",
      "say": "Filtering to \"example.com\" — I can't read your account from here, so this is a guess at the name.",
      "targetFallback": {
        "description": "the search box in the consent categories picker"
      },
      "action": {
        "type": "fill_text",
        "value": "example.com"
      },
      "completion": {
        "type": "dom_event",
        "value": "input"
      },
      "id": "s11"
    },
    {
      "actor": "user",
      "targetSelector": ".op-standards-selector .add-all-standards-btn",
      "say": "Attach the one that covers this site.",
      "targetFallback": {
        "description": "the \"add all\" button in the picker"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      },
      "id": "s12"
    },
    {
      "actor": "user",
      "targetSelector": "[op-selector=\"standards-tab-alerts\"]",
      "say": "Open Alerts.",
      "targetFallback": {
        "description": "the \"Alerts\" sub-tab under Standards"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      },
      "id": "s13"
    },
    {
      "actor": "user",
      "targetSelector": ".op-standards-selector .add-all-standards-btn",
      "say": "Add the alerts that should fire when a run breaches them.",
      "targetFallback": {
        "description": "the \"add all\" button in the picker"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      },
      "id": "s14"
    },
    {
      "id": "s15",
      "actor": "user",
      "targetSelector": "[op-selector=\"web-audit-create-save\"]",
      "say": "Save Audit — nothing exists until you do. \"Save Changes & Run Now\" next to it also kicks off the first run.",
      "targetFallback": {
        "description": "the \"Save Audit\" button at the bottom of the editor"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    }
  ]
}
