{
  "recipeId": "audit_with_rules",
  "goal": "set up an audit for https://www.example.com that checks my tag rules",
  "summary": "We'll create an audit called \"example.com — Tag & variable rules\" against https://www.example.com, then attach your Tag & Variable Rules under Standards so every run reports pass/fail against them.",
  "executionMode": "templated",
  "parameters": {
    "siteUrl": "https://www.example.com",
    "auditName": "example.com — Tag & variable rules"
  },
  "steps": [
    {
      "id": "s1",
      "actor": "user",
      "navContext": "*",
      "targetSelector": "[op-selector=\"sidebar-create-new\"]",
      "say": "Click Create New in the left sidebar.",
      "targetFallback": {
        "description": "the \"Create New\" button in the left sidebar"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": "[op-selector=\"new-data-option-audit\"]"
      }
    },
    {
      "id": "s2",
      "actor": "user",
      "targetSelector": "[op-selector=\"new-data-option-audit\"]",
      "say": "Choose Audit.",
      "targetFallback": {
        "description": "the \"Audit\" option in the Create New dialog"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-audit-editor, .audit-setup-modal"
      }
    },
    {
      "id": "s3",
      "actor": "user",
      "optional": true,
      "targetSelector": "[op-selector=\"web-audit-switch-to-advanced-setup\"]",
      "say": "Switch to Advanced Setup — Standards lives there.",
      "targetFallback": {
        "description": "the \"Switch to Advanced Setup\" button"
      },
      "unverified": true,
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-audit-editor"
      }
    },
    {
      "id": "s4",
      "actor": "ai",
      "targetSelector": "audit-editor-header-name-control input",
      "say": "Naming it \"example.com — Tag & variable rules\".",
      "targetFallback": {
        "description": "the audit name field in the editor header"
      },
      "action": {
        "type": "fill_text",
        "value": "example.com — Tag & variable rules"
      },
      "completion": {
        "type": "dom_event",
        "value": "change"
      }
    },
    {
      "id": "s5",
      "actor": "user",
      "targetSelector": "[op-selector=\"audit-tab-url-sources\"], .op-audit-editor .op-tabs:not(.sub-menu) .op-tab:nth-child(2)",
      "say": "Open URL Sources.",
      "targetFallback": {
        "description": "the URL Sources tab in the audit editor"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    },
    {
      "id": "s6",
      "actor": "ai",
      "targetSelector": "[op-selector=\"audit-setup-starting-urls-textarea\"] textarea",
      "say": "Setting the starting URL.",
      "targetFallback": {
        "description": "the \"URLs to Scan\" box on the URL Sources tab"
      },
      "action": {
        "type": "fill_text",
        "value": "https://www.example.com"
      },
      "completion": {
        "type": "dom_event",
        "value": "change"
      }
    },
    {
      "id": "s7",
      "actor": "user",
      "targetSelector": "[op-selector=\"audit-tab-standards\"], .op-audit-editor .op-tabs:not(.sub-menu) .op-tab:nth-child(4)",
      "say": "Open the Standards tab.",
      "targetFallback": {
        "description": "the Standards tab in the audit editor"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-tabs.sub-menu"
      }
    },
    {
      "id": "s8",
      "actor": "user",
      "targetSelector": "[op-selector=\"standards-tab-rules\"]",
      "say": "Open Tag & Variable Rules.",
      "targetFallback": {
        "description": "the \"Tag & Variable Rules\" sub-tab"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    },
    {
      "id": "s9",
      "actor": "user",
      "targetSelector": ".op-standards-selector .search-input",
      "say": "Search your rule library.",
      "targetFallback": {
        "description": "the search box in the rules picker"
      },
      "completion": {
        "type": "dom_event",
        "value": "input"
      }
    },
    {
      "id": "s10",
      "actor": "user",
      "targetSelector": ".op-standards-selector .add-all-standards-btn",
      "say": "Add the rules you want.",
      "targetFallback": {
        "description": "the \"add all\" button in the rules picker"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    },
    {
      "id": "s11",
      "actor": "user",
      "targetSelector": ".op-standards-selector .create-new-btn",
      "say": "Nothing fits? Create a rule here instead.",
      "targetFallback": {
        "description": "the \"Create New Rule\" button"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    },
    {
      "id": "s12",
      "actor": "user",
      "targetSelector": "[op-selector=\"web-audit-create-save\"]",
      "say": "Save Audit — nothing exists until you do.",
      "targetFallback": {
        "description": "the \"Save Audit\" button at the bottom of the editor"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    }
  ]
}
