{
  "recipeId": "audit_with_rules",
  "goal": "set up an audit for https://www.example.com that checks my tag rules",
  "summary": "We'll create an audit called \"example.com — Tag & variable rules\" against https://www.example.com, then attach your Tag & Variable Rules under Standards so every run reports pass/fail against them.",
  "executionMode": "templated",
  "parameters": {
    "siteUrl": "https://www.example.com",
    "auditName": "example.com — Tag & variable rules"
  },
  "steps": [
    {
      "id": "s1",
      "actor": "user",
      "navContext": "/data-sources",
      "targetSelector": "#guide-create-new-data-src-btn",
      "say": "Audits are created from Data Sources. Open the create menu.",
      "targetFallback": {
        "description": "the Create button on the Data Sources page"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    },
    {
      "id": "s2",
      "actor": "user",
      "targetSelector": "#guide-create-new-audit",
      "say": "Choose Web Audit.",
      "targetFallback": {
        "description": "the Web Audit item in the create menu"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".audit-setup-modal"
      }
    },
    {
      "id": "s3",
      "actor": "ai",
      "targetSelector": "[op-selector=\"audit-setup-name\"] input",
      "say": "Naming it \"example.com — Tag & variable rules\".",
      "action": {
        "type": "fill_text",
        "value": "example.com — Tag & variable rules"
      },
      "completion": {
        "type": "dom_event",
        "value": "change"
      }
    },
    {
      "id": "s4",
      "actor": "ai",
      "targetSelector": "[op-selector=\"audit-setup-starting-urls-textarea\"] textarea",
      "say": "This is where the crawl starts. One URL per line if you want several.",
      "action": {
        "type": "fill_text",
        "value": "https://www.example.com"
      },
      "completion": {
        "type": "dom_event",
        "value": "change"
      }
    },
    {
      "id": "s5",
      "actor": "user",
      "targetSelector": "[op-selector=\"web-audit-switch-to-advanced-setup\"]",
      "say": "Quick setup has no Standards section, so switch to Advanced Setup — that is where rules, consent categories and alerts are attached.",
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-audit-editor"
      }
    },
    {
      "id": "s6",
      "actor": "user",
      "targetSelector": ".op-audit-editor .op-tabs:not(.sub-menu) .op-tab:nth-child(4)",
      "say": "Open the Standards tab.",
      "targetFallback": {
        "description": "the Standards tab in the audit editor"
      },
      "unverified": true,
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-tabs.sub-menu"
      }
    },
    {
      "id": "s7",
      "actor": "user",
      "targetSelector": ".op-audit-editor .op-tabs.sub-menu .op-tab:nth-child(1)",
      "say": "Tag & Variable Rules is the first sub-tab. This is what makes an audit check things rather than just crawl.",
      "targetFallback": {
        "description": "the \"Tag & Variable Rules\" sub-tab"
      },
      "unverified": true,
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-standards-selector"
      }
    },
    {
      "id": "s8",
      "actor": "user",
      "targetSelector": ".op-standards-selector .search-input",
      "say": "Search your rule library for the ones you want. Start narrow — a few rules you trust beats every rule you own, because a noisy audit gets ignored.",
      "targetFallback": {
        "description": "the search box in the rules picker"
      },
      "unverified": true,
      "completion": {
        "type": "dom_event",
        "value": "input"
      }
    },
    {
      "id": "s9",
      "actor": "user",
      "targetSelector": ".op-standards-selector .add-all-standards-btn",
      "say": "Add the ones you found. Anything on the right-hand side is evaluated on every run of this audit.",
      "targetFallback": {
        "description": "the \"add all\" button in the rules picker"
      },
      "unverified": true,
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    },
    {
      "id": "s10",
      "actor": "user",
      "targetSelector": ".op-standards-selector .create-new-btn",
      "say": "If no existing rule covers https://www.example.com, create one from here — you will not lose this audit.",
      "targetFallback": {
        "description": "the \"Create New Rule\" button"
      },
      "unverified": true,
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    }
  ]
}
