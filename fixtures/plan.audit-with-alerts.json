{
  "recipeId": "audit_with_alerts",
  "goal": "add alerts to my audit for https://www.example.com",
  "summary": "We'll create an audit called \"example.com — Alerting\" against https://www.example.com and attach alerts under Standards. Alerts watch report data, so nothing fires until the first run finishes.",
  "executionMode": "templated",
  "parameters": {
    "siteUrl": "https://www.example.com",
    "auditName": "example.com — Alerting"
  },
  "steps": [
    {
      "id": "s1",
      "actor": "user",
      "navContext": "/data-sources",
      "targetSelector": "#guide-create-new-data-src-btn",
      "say": "Open the create menu.",
      "targetFallback": {
        "description": "the Create button on the Data Sources page"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    },
    {
      "id": "s2",
      "actor": "user",
      "targetSelector": "#guide-create-new-audit",
      "say": "Choose Web Audit.",
      "targetFallback": {
        "description": "the Web Audit item in the create menu"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".audit-setup-modal"
      }
    },
    {
      "id": "s3",
      "actor": "ai",
      "targetSelector": "[op-selector=\"audit-setup-name\"] input",
      "say": "Naming it \"example.com — Alerting\".",
      "action": {
        "type": "fill_text",
        "value": "example.com — Alerting"
      },
      "completion": {
        "type": "dom_event",
        "value": "change"
      }
    },
    {
      "id": "s4",
      "actor": "ai",
      "targetSelector": "[op-selector=\"audit-setup-starting-urls-textarea\"] textarea",
      "say": "Setting the starting URL.",
      "action": {
        "type": "fill_text",
        "value": "https://www.example.com"
      },
      "completion": {
        "type": "dom_event",
        "value": "change"
      }
    },
    {
      "id": "s5",
      "actor": "user",
      "targetSelector": "[op-selector=\"web-audit-switch-to-advanced-setup\"]",
      "say": "Switch to Advanced Setup — Standards lives there.",
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-audit-editor"
      }
    },
    {
      "id": "s6",
      "actor": "user",
      "targetSelector": ".op-audit-editor .op-tabs:not(.sub-menu) .op-tab:nth-child(4)",
      "say": "Open the Standards tab.",
      "targetFallback": {
        "description": "the Standards tab in the audit editor"
      },
      "unverified": true,
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-tabs.sub-menu"
      }
    },
    {
      "id": "s7",
      "actor": "user",
      "targetSelector": ".op-audit-editor .op-tabs.sub-menu .op-tab:nth-child(3)",
      "say": "Open Alerts.",
      "targetFallback": {
        "description": "the \"Alerts\" sub-tab"
      },
      "unverified": true,
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-standards-selector"
      }
    },
    {
      "id": "s8",
      "actor": "user",
      "targetSelector": ".op-standards-selector .search-input",
      "say": "Search your alerts.",
      "targetFallback": {
        "description": "the search box in the alerts picker"
      },
      "unverified": true,
      "completion": {
        "type": "dom_event",
        "value": "input"
      }
    },
    {
      "id": "s9",
      "actor": "user",
      "targetSelector": ".op-standards-selector .add-all-standards-btn",
      "say": "Attach them.",
      "targetFallback": {
        "description": "the \"add all\" button in the alerts picker"
      },
      "unverified": true,
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    },
    {
      "id": "s10",
      "actor": "user",
      "targetSelector": ".op-standards-selector .create-new-btn",
      "say": "Nothing fits? Create an alert here instead.",
      "targetFallback": {
        "description": "the \"Create New Alert\" button"
      },
      "unverified": true,
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    }
  ]
}
