{
  "recipeId": "audit_with_consent_categories",
  "goal": "audit https://www.example.com for GDPR consent compliance",
  "summary": "We'll create an audit called \"example.com — Consent & privacy\" against https://www.example.com and attach Consent Categories under Standards. Without one attached, a privacy audit runs but reports nothing.",
  "executionMode": "templated",
  "parameters": {
    "siteUrl": "https://www.example.com",
    "auditName": "example.com — Consent & privacy"
  },
  "steps": [
    {
      "id": "s1",
      "actor": "user",
      "navContext": "/sources",
      "targetSelector": "#guide-create-new-data-src-btn",
      "say": "Open the create menu.",
      "targetFallback": {
        "description": "the Create button on the Data Sources page"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    },
    {
      "id": "s2",
      "actor": "user",
      "targetSelector": "#guide-create-new-audit",
      "say": "Choose Audit.",
      "targetFallback": {
        "description": "the Audit item in the create menu"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-audit-editor"
      }
    },
    {
      "id": "s3",
      "actor": "ai",
      "targetSelector": "audit-editor-header-name-control input",
      "say": "Naming it \"example.com — Consent & privacy\".",
      "action": {
        "type": "fill_text",
        "value": "example.com — Consent & privacy"
      },
      "completion": {
        "type": "dom_event",
        "value": "change"
      }
    },
    {
      "id": "s4",
      "actor": "user",
      "targetSelector": "[op-selector=\"audit-tab-url-sources\"], .op-audit-editor .op-tabs:not(.sub-menu) .op-tab:nth-child(2)",
      "say": "Open URL Sources.",
      "targetFallback": {
        "description": "the URL Sources tab in the audit editor"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    },
    {
      "id": "s5",
      "actor": "ai",
      "targetSelector": "[op-selector=\"audit-setup-starting-urls-textarea\"] textarea",
      "say": "Setting the starting URL.",
      "action": {
        "type": "fill_text",
        "value": "https://www.example.com"
      },
      "completion": {
        "type": "dom_event",
        "value": "change"
      }
    },
    {
      "id": "s6",
      "actor": "user",
      "targetSelector": "[op-selector=\"audit-tab-standards\"], .op-audit-editor .op-tabs:not(.sub-menu) .op-tab:nth-child(4)",
      "say": "Open the Standards tab.",
      "targetFallback": {
        "description": "the Standards tab in the audit editor"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-tabs.sub-menu"
      }
    },
    {
      "id": "s7",
      "actor": "user",
      "targetSelector": "[op-selector=\"standards-tab-consent-categories\"]",
      "say": "Open Consent Categories.",
      "targetFallback": {
        "description": "the \"Consent Categories\" sub-tab"
      },
      "completion": {
        "type": "dom_mutation",
        "condition": "visible",
        "targetSelector": ".op-standards-selector"
      }
    },
    {
      "id": "s8",
      "actor": "user",
      "targetSelector": ".op-standards-selector .search-input",
      "say": "Search for the category that covers this site.",
      "targetFallback": {
        "description": "the search box in the consent categories picker"
      },
      "completion": {
        "type": "dom_event",
        "value": "input"
      }
    },
    {
      "id": "s9",
      "actor": "user",
      "targetSelector": ".op-standards-selector .add-all-standards-btn",
      "say": "Attach it.",
      "targetFallback": {
        "description": "the \"add all\" button in the consent categories picker"
      },
      "completion": {
        "type": "dom_event",
        "value": "click"
      }
    }
  ]
}
