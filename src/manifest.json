{
  "manifest_version": 3,
  "name": "ObservePoint Copilot",
  "version": "0.1.0",
  "description": "Ask for what you want to achieve; get walked through the steps in the app.",
  "minimum_chrome_version": "114",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"]
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "permissions": ["storage", "activeTab", "sidePanel", "tabs", "scripting"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://*.observepoint.com/*",
    "https://*.observepointstaging.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
