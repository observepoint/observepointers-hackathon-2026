{
  "manifest_version": 3,
  "name": "Observe Pointers",
  "version": "0.1.0",
  "description": "Ask for what you want to achieve; get walked through the steps in the app.",
  "minimum_chrome_version": "114",
  "action": {
    "default_icon": {
      "16": "icons/observe_pointers_16x16.png",
      "48": "icons/observe_pointers_48x48.png",
      "128": "icons/observe_pointers_128x128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.observepoint.com/*",
        "https://*.app.observepoint.com/*",
        "https://app.observepointstaging.com/*",
        "https://*.app.observepointstaging.com/*",
        "https://*.observepointstaging.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*"
      ],
      "js": ["src/content/index.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://app.observepoint.com/*",
    "https://*.app.observepoint.com/*",
    "https://app.observepointstaging.com/*",
    "https://*.app.observepointstaging.com/*",
    "https://*.observepointstaging.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*",
    "https://127.0.0.1/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": [
        "https://app.observepoint.com/*",
        "https://*.app.observepoint.com/*",
        "https://app.observepointstaging.com/*",
        "https://*.app.observepointstaging.com/*",
        "https://*.observepointstaging.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://localhost/*",
        "https://127.0.0.1/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/observe_pointers_16x16.png",
    "48": "icons/observe_pointers_48x48.png",
    "128": "icons/observe_pointers_128x128.png"
  }
}
